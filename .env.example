# Example environment variables for local development
# Copy this file to .env.local and fill in your own values.

# Stripe secret key for checkout
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Optional public site URL used for redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Monobank API token for monopay pubkey import
MONOBANK_API_TOKEN=your_monobank_api_token_here

# Base64-encoded Monobank public key for import
MONOBANK_PUBKEY_BASE64=your_base64_public_key_here
MONOBANK_PUBKEY_NAME=my_key
MONOBANK_PUBKEY_EXPIRES_AT=2026-02-02T15:04:05+03:00

# Telegram bot for order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=koblevskivina_bot
