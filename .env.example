# Example environment variables for local development
# Copy this file to .env.local and fill in your own values.

# Telegram bot for order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=koblevskivina_bot

# Public production origin used to reject cross-site order requests.
# Example: https://koblivski-vyna.vercel.app
SITE_ORIGIN=http://localhost:3000

# Cloudflare Turnstile. The site key is public; keep the secret server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional server-side alias for the public site key:
# TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
